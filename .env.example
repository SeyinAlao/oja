# Any OpenAI-compatible /v1/chat/completions endpoint with vision support.
# Defaults point at a local Ollama.
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gemma3:4b
# Optional. Leave empty for Ollama; set for hosted providers.
AI_API_KEY=
# Optional. Request timeout in seconds (local CPU models can be slow).
AI_TIMEOUT_SECONDS=300
# Optional. Only sent when set; some models reject it (Gemma 4 on Google's endpoint does).
AI_REASONING_EFFORT=
# Optional. Reply length cap. 900 is the default.
AI_MAX_TOKENS=

# Optional fallback model, used once when the primary still fails with 429, 5xx or a
# network error after its retry. Disabled when AI_FALLBACK_MODEL is unset.
# Base URL defaults to AI_BASE_URL. The key defaults to AI_API_KEY only when the base URL
# is the same; set AI_FALLBACK_API_KEY yourself for a different provider.
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
