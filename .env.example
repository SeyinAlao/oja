# Any OpenAI-compatible /v1/chat/completions endpoint with vision support.
# Defaults point at a local Ollama.
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gemma3:4b
# Optional. Leave empty for Ollama; set for hosted providers.
AI_API_KEY=
# Optional. Request timeout in seconds (local CPU models can be slow).
AI_TIMEOUT_SECONDS=300
# Optional. Only sent when set; some models reject it (Gemma 4 on Google's endpoint does).
AI_REASONING_EFFORT=
# Optional. Reply length cap. 900 is the default.
AI_MAX_TOKENS=
